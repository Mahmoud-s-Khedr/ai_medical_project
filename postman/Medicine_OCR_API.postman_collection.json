    {
      "name": "🔍 OCR Search",
      "item": [
        {
          "name": "OCR Medicine Search",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "image", "type": "file", "src": "", "description": "Upload a medicine box/label image (JPG, PNG)"},
                {"key": "top_k", "value": "5", "type": "text", "description": "Max number of results to return (1-20)"}
              ]
            },
            "url": {"raw": "{{base_url}}/api/uploads/ocr-search/", "host": ["{{base_url}}"], "path": ["api", "uploads", "ocr-search", ""]},
            "description": "Upload a medicine image and get fuzzy-matched results from the database.\n\n**Request:** `multipart/form-data`\n- `image` (required): medicine box photo\n- `top_k` (optional): number of results, default 5, max 20\n\n**Response:**\n- `ocr_raw_text`: extracted text\n- `ocr_confidence`: 0.0–1.0\n- `ocr_engine`: `easyocr` or `tesseract`\n- `matches`: ranked list of medicines with similarity score"
          }
        }
      ]
    },
