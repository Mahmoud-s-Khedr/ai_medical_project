SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# Database
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: postgres://user:password@host:5432/dbname

# Email — use SMTP in production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL for password-reset links
FRONTEND_URL=https://yourdomain.com

# Text-to-Speech (TTS)
TTS_DEFAULT_VOICE_EN=en-US-JennyNeural
TTS_DEFAULT_VOICE_AR=ar-EG-SalmaNeural
TTS_DEFAULT_VOICE_MIXED=ar-EG-SalmaNeural
TTS_MAX_CHARS=2000
TTS_TIMEOUT_SECONDS=30
TTS_MIXED_MODE_DEFAULT=dual_voice
TTS_STITCH_SILENCE_MS=80
TTS_MAX_SEGMENTS=24
